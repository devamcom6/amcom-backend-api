# ---------------------------------------------------------------------------
# Amcom API — environment template. Copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

APP_NAME=Amcom
APP_ENV=local
APP_KEY=
# Must be false in staging/production (stack traces are never returned by the API anyway).
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Frontend (Vue) — primary URL for links/OAuth, plus the comma-separated allow-list used for CORS
# and the Paystack callback_url whitelist (<origin>/payments/callback).
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=false

# Comma-separated proxy IPs/CIDRs in front of the app (load balancer, Cloudflare), or * behind a trusted LB.
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amcom
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queues: emails, webhooks and media cleanup run in the background. Use database or redis
# (run `php artisan queue:work`). `sync` is only for quick local experiments.
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Authentication (Sanctum personal access tokens)
AUTH_TOKEN_TTL_MINUTES=1440
AUTH_REMEMBER_TTL_MINUTES=43200
# email | sms (sms requires SMS_DRIVER=termii)
TWO_FACTOR_CHANNEL=email
SANCTUM_STATEFUL_DOMAINS=

# --- Mail: Zoho ZeptoMail (all transactional email) --------------------------
# Use MAIL_MAILER=log locally to write emails to storage/logs instead of sending.
MAIL_MAILER=zeptomail
MAIL_FROM_ADDRESS="noreply@amcom.example"
MAIL_FROM_NAME="${APP_NAME}"
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
ZEPTOMAIL_FROM_NAME="${APP_NAME}"
ZEPTOMAIL_BOUNCE_ADDRESS=
ZEPTOMAIL_ENDPOINT=https://api.zeptomail.com/v1.1/email

# Operations inbox for internal alerts (leads, payouts, refunds). Editable in admin settings.
ADMIN_ALERT_EMAIL=ops@amcom.example
FACILITY_MANAGER_EMAIL=
SUPPORT_EMAIL=info@houvincity.com
SUPPORT_PHONE="+234 707 469 3320"
COMPANY_LEGAL_NAME="HOUVINCITY Global Limited"

# --- Cloudinary (all image storage; secret never leaves the backend) ---------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=amcom

# --- Paystack (secret key only on the backend) -------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Optional extra filter on webhook source IPs (comma-separated). Signature is always verified.
PAYSTACK_WEBHOOK_IPS=
PLOT_RESERVATION_MINUTES=30

# --- Identity verification (onboarding step 1) -------------------------------
# fake (dev only: any well-formed ID verifies) | persona
IDENTITY_DRIVER=fake
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=

# --- SMS (2FA / phone change). log | termii -----------------------------------
SMS_DRIVER=log
TERMII_API_KEY=
TERMII_SENDER_ID=Amcom

# --- Google sign-in (Socialite). Redirect must be the FRONTEND callback route. --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${FRONTEND_URL}/auth/google/callback"

BUSINESS_TIMEZONE=Africa/Lagos

# --- Development seeding only ---------------------------------------------------
SEED_PASSWORD=Password123!
SEED_UPLOAD_IMAGES=false
